{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rakeshnitb23/opfence/schema/rules.schema.json",
  "title": "Opfence catalog rule file (catalog/<provider>/<name>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["operations"],
  "properties": {
    "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rule" } }
  },
  "$defs": {
    "class": { "enum": ["read", "write", "delete", "irreversible", "money", "credential", "access", "unknown"] },
    "sqlDialect": { "enum": ["postgres", "mysql", "sqlite", "googlesql"] },
    "argPath": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*(\\.[A-Za-z_$][A-Za-z0-9_$-]*)*$" },
    "responsePath": { "type": "string", "pattern": "^(\\*\\*\\.)*[A-Za-z_$][A-Za-z0-9_$-]*(\\.(\\*\\*\\.)*[A-Za-z_$][A-Za-z0-9_$-]*)*$", "description": "A dotted path; a ** step stands for any number of keys" },
    "ruleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$" },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "match", "class", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/ruleId" },
        "aliases": { "type": "array", "items": { "$ref": "#/$defs/ruleId" } },
        "match": { "$ref": "#/$defs/match" },
        "class": { "$ref": "#/$defs/class" },
        "when": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["if", "class"],
            "properties": { "if": { "$ref": "#/$defs/condition" }, "class": { "$ref": "#/$defs/class" } }
          }
        },
        "classify": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            { "required": ["sql"], "not": { "anyOf": [{ "required": ["redis"] }, { "required": ["aws_cli"] }, { "required": ["provider"] }, { "required": ["postgrest"] }] } },
            { "required": ["redis"], "not": { "anyOf": [{ "required": ["sql"] }, { "required": ["aws_cli"] }, { "required": ["provider"] }, { "required": ["dialect"] }, { "required": ["format"] }, { "required": ["postgrest"] }] } },
            { "required": ["aws_cli", "provider"], "not": { "anyOf": [{ "required": ["sql"] }, { "required": ["redis"] }, { "required": ["dialect"] }, { "required": ["format"] }, { "required": ["postgrest"] }] } },
            { "required": ["postgrest"], "not": { "anyOf": [{ "required": ["sql"] }, { "required": ["redis"] }, { "required": ["aws_cli"] }, { "required": ["provider"] }, { "required": ["dialect"] }, { "required": ["format"] }] } }
          ],
          "properties": {
            "sql": {
              "description": "Arguments holding SQL: one path, or several when the SQL may be in any of them",
              "oneOf": [
                { "$ref": "#/$defs/argPath" },
                { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/argPath" } }
              ]
            },
            "dialect": {
              "description": "The SQL the server speaks (postgres by default); several when it could be any of them",
              "oneOf": [
                { "$ref": "#/$defs/sqlDialect" },
                { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sqlDialect" } }
              ]
            },
            "format": { "enum": ["libsql"], "description": "libsql: the argument is a libSQL HTTP request body, read as SQLite" },
            "postgrest": { "$ref": "#/$defs/argPath", "description": "Argument holding a PostgREST request's query parameters (query): the rule's class when a filter limits the rows a PATCH or DELETE changes, irreversible when none does" },
            "aws_cli": { "$ref": "#/$defs/argPath", "description": "Argument holding AWS CLI command lines (one or a list); provider names the SigV4 provider whose rules decide them" },
            "provider": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
            "redis": {
              "description": "Arguments holding Redis commands: a list of commands (each a list of words) or one command",
              "oneOf": [
                { "$ref": "#/$defs/argPath" },
                { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/argPath" } }
              ]
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class"],
          "properties": {
            "redact": { "type": "array", "items": { "$ref": "#/$defs/responsePath" } },
            "clear": { "type": "array", "items": { "$ref": "#/$defs/responsePath" } },
            "mint": { "type": "array", "items": { "$ref": "#/$defs/responsePath" } },
            "hold": { "type": "array", "items": { "$ref": "#/$defs/responsePath" }, "description": "Paths whose strings the proxy replaces with tokens it can swap back when a write carries them to the same field of the same object" },
            "class": { "$ref": "#/$defs/class" }
          }
        },
        "restore": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/responsePath" }, "description": "Body paths of a write where the proxy swaps values it held from the same object back in" },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["arg", "kind"],
          "properties": { "arg": { "$ref": "#/$defs/argPath" }, "kind": { "type": "string", "minLength": 1 } }
        },
        "card": { "type": "string", "description": "Approval card text; {arg.path} placeholders are filled from decoded arguments" },
        "unlisted": { "type": "string", "minLength": 1, "description": "Why the operation is not in the provider's schemas; the drift check skips it" },
        "status": { "enum": ["verified", "community", "draft"] },
        "verified": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "sources": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
        "notes": { "type": "string" },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fixture", "expect"],
            "properties": {
              "fixture": { "type": "string", "pattern": "^fixtures/" },
              "expect": { "$ref": "#/$defs/class" },
              "resource": { "type": "string" },
              "response": { "type": "string", "pattern": "^fixtures/.*\\.json$" }
            }
          }
        }
      },
      "if": { "properties": { "status": { "const": "verified" } } },
      "then": { "required": ["tests", "sources", "verified"] }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "rest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path"],
          "properties": {
            "method": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"] },
            "path": { "type": "string", "pattern": "^/" }
          }
        },
        "graphql": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "field"],
          "properties": {
            "type": { "enum": ["query", "mutation", "subscription"] },
            "field": { "type": "string", "pattern": "^[_A-Za-z][_0-9A-Za-z]*$" }
          }
        },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool"],
          "properties": { "tool": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" } }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service"],
          "properties": {
            "service": { "type": "string", "pattern": "^[a-z0-9-]+$" },
            "action": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
            "method": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"] },
            "path": { "type": "string", "pattern": "^/" }
          },
          "oneOf": [
            { "required": ["action"], "not": { "anyOf": [{ "required": ["method"] }, { "required": ["path"] }] } },
            { "required": ["method", "path"], "not": { "required": ["action"] } }
          ]
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": ["service", "command"],
          "properties": {
            "service": { "enum": ["upload-pack", "receive-pack", "lfs"] },
            "command": { "enum": ["fetch", "list", "create", "update", "delete", "download", "upload", "list-locks", "lock", "unlock"] },
            "refs": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^refs/[A-Za-z0-9._/-]*\\*?$" } }
          }
        },
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": { "command": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arg"],
      "minProperties": 2,
      "maxProperties": 2,
      "properties": {
        "arg": { "$ref": "#/$defs/argPath" },
        "equals": { "type": "string" },
        "in": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "present": { "const": true },
        "absent": { "const": true },
        "empty": { "const": true },
        "matches": { "type": "string" }
      }
    }
  }
}
