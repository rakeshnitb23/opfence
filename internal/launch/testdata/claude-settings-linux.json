{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "httpProxyPort": 41001,
      "socksProxyPort": 41002
    },
    "filesystem": {
      "denyRead": [
        "/home/dev/.local/state/opfence",
        "/run/user/1000/bus",
        "/run/user/1000/keyring"
      ],
      "denyWrite": [
        "/home/dev/.config/opfence",
        "/home/dev/.local/state/opfence",
        "/home/dev/.cache/opfence",
        "/home/dev/Program Files/opfence",
        "/home/dev/project/.claude/settings.json",
        "/home/dev/project/.claude/settings.local.json"
      ]
    }
  },
  "permissions": {
    "deny": [
      "Read(//home/dev/.local/state/opfence/**)",
      "Read(//proc/**)",
      "Read(//run/user/1000/bus)",
      "Read(//run/user/1000/keyring)",
      "Edit(//home/dev/.config/opfence/**)",
      "Edit(//home/dev/.local/state/opfence/**)",
      "Edit(//home/dev/.cache/opfence/**)",
      "Edit(//home/dev/Program Files/opfence)",
      "Edit(//home/dev/project/.claude/settings.json)",
      "Edit(//home/dev/project/.claude/settings.local.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "'/home/dev/Program Files/opfence' --user-config '/home/dev/it'\\''s here/config.yaml' hook claude-code",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "disableAllHooks": false,
  "env": {
    "HTTPS_PROXY": "http://127.0.0.1:41003",
    "OPFENCE_CONFIG": "/home/dev/it's here/config.yaml"
  }
}
