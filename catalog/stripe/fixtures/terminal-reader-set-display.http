# description: Show a cart on reader tmr_ShopFront0001
POST /v1/terminal/readers/tmr_ShopFront0001/set_reader_display HTTP/1.1
Host: api.stripe.com
Authorization: Bearer opf_stripe_EXAMPLE
Content-Type: application/x-www-form-urlencoded

type=cart&cart[currency]=usd&cart[total]=2000&cart[line_items][0][description]=Tee&cart[line_items][0][amount]=2000&cart[line_items][0][quantity]=1
