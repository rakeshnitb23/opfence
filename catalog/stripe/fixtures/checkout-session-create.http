# description: Create a Checkout session (payment)
POST /v1/checkout/sessions HTTP/1.1
Host: api.stripe.com
Authorization: Bearer opf_stripe_EXAMPLE
Content-Type: application/x-www-form-urlencoded

mode=payment&line_items[0][price]=price_ShopTee0001&line_items[0][quantity]=1&success_url=https%3A%2F%2Fshop.example.com%2Fthanks
