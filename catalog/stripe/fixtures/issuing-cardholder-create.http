# description: Create cardholder Jane Doe
POST /v1/issuing/cardholders HTTP/1.1
Host: api.stripe.com
Authorization: Bearer opf_stripe_EXAMPLE
Content-Type: application/x-www-form-urlencoded

type=individual&name=Jane%20Doe&email=jane%40example.com&billing[address][line1]=1%20Main%20St&billing[address][city]=San%20Francisco&billing[address][state]=CA&billing[address][postal_code]=94111&billing[address][country]=US
