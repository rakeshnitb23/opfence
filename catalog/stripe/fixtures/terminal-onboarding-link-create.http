# description: Create a Tap to Pay onboarding link
POST /v1/terminal/onboarding_links HTTP/1.1
Host: api.stripe.com
Authorization: Bearer opf_stripe_EXAMPLE
Content-Type: application/x-www-form-urlencoded

link_type=apple_terms_and_conditions&link_options[apple_terms_and_conditions][merchant_display_name]=Acme&on_behalf_of=acct_1ShopConnect01
