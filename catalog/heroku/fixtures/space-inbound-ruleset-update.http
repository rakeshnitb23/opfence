# description: Replace the inbound IP rules of space acme-prod
PUT /spaces/acme-prod/inbound-ruleset HTTP/1.1
Host: api.heroku.com
Authorization: Bearer opf_heroku_EXAMPLE
Accept: application/vnd.heroku+json; version=3
Content-Type: application/json

{"rules":[{"action":"allow","source":"0.0.0.0/0"}]}
