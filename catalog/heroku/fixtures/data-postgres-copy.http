# description: Copy database shop on db.example.com:5432 over HEROKU_POSTGRESQL_RED, replacing its data
POST /client/v11/databases/6f1c2a7e-3b9d-4e5f-8a1b-2c3d4e5f6a7b/transfers HTTP/1.1
Host: api.data.heroku.com
Authorization: Bearer opf_heroku_EXAMPLE
Accept: application/vnd.heroku+json; version=3
Content-Type: application/json

{"from_name": "database shop on db.example.com:5432", "from_url": "postgres://db.example.com/shop", "to_name": "HEROKU_POSTGRESQL_RED", "to_url": "postgres://ec2.compute.amazonaws.com/d1"}
