# description: Change the routable networks of VPN connection office in space acme-prod
PATCH /spaces/acme-prod/vpn-connections/office HTTP/1.1
Host: api.heroku.com
Authorization: Bearer opf_heroku_EXAMPLE
Accept: application/vnd.heroku+json; version=3
Content-Type: application/json

{"routable_cidrs":["192.168.0.0/16","10.20.0.0/16"]}
