# description: Let Postgres database 6f1c2a7e-3b9d-4e5f-8a1b-2c3d4e5f6a7b subscribe to logical replication
POST /data/postgres/v1/6f1c2a7e-3b9d-4e5f-8a1b-2c3d4e5f6a7b/logical-replication/subscribing/enable HTTP/1.1
Host: api.data.heroku.com
Authorization: Bearer opf_heroku_EXAMPLE
Accept: application/vnd.heroku+json; version=3

