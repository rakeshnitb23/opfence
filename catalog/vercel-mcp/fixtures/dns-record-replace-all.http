# description: Replace every DNS record of shop.example.com
POST / HTTP/1.1
Host: mcp.vercel.com
Authorization: Bearer opf_vercel-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"replace_domain_dns_records","arguments":{"teamId":"team_acme","requestBody":"www 60 IN CNAME cname.vercel-dns.com.\n","domain":"shop.example.com"}}}
