# description: Create CNAME record www on shop.example.com
POST / HTTP/1.1
Host: mcp.vercel.com
Authorization: Bearer opf_vercel-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"create_record","arguments":{"teamId":"team_acme","requestBody":{"name":"www","type":"CNAME","value":"cname.vercel-dns.com"},"domain":"shop.example.com"}}}
