# description: Deploy inline files to preview of project shop-web
POST / HTTP/1.1
Host: mcp.vercel.com
Authorization: Bearer opf_vercel-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"deploy_to_vercel","arguments":{"teamId":"team_acme","target":"preview","files":[{"file":"index.html","data":"<h1>Hello</h1>"}],"name":"shop-web"}}}
