# description: Export documents from orders in shop (open orders)
POST / HTTP/1.1
Host: mcp.mongodb.com
Authorization: Bearer opf_mongodb-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"export","arguments":{"connectionId":"conn-orders","database":"shop","collection":"orders","exportTitle":"open orders","exportTarget":[{"name":"find","arguments":{"filter":{"status":"open"}}}]}}}
