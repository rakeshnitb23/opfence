# description: Rename collection orders_staging in shop to orders
POST / HTTP/1.1
Host: mcp.mongodb.com
Authorization: Bearer opf_mongodb-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"rename-collection","arguments":{"connectionId":"conn-orders","database":"shop","collection":"orders_staging","newName":"orders","dropTarget":true}}}
