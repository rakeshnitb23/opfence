# description: Change a Turso database's delete protection, allow rules or size limit
POST /mcp HTTP/1.1
Host: mcp.turso.ai
Authorization: Bearer opf_turso-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"set_database_config","arguments":{"database":"app-db","delete_protection":false}}}
