# description: Run a read-only SQL query on a Turso database
POST /mcp HTTP/1.1
Host: mcp.turso.ai
Authorization: Bearer opf_turso-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"read_database","arguments":{"database":"app-db","query":"SELECT count(*) FROM users"}}}
