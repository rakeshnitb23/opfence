# description: List the links on https://shop-example.com/pricing
POST /mcp HTTP/1.1
Host: browser.mcp.cloudflare.com
Authorization: Bearer opf_cloudflare-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":64,"method":"tools/call","params":{"name":"get_url_links","arguments":{"url":"https://shop-example.com/pricing","visibleLinksOnly":true}}}
