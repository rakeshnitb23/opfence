# description: Radar: Get traffic anomalies by location
POST /mcp HTTP/1.1
Host: radar.mcp.cloudflare.com
Authorization: Bearer opf_cloudflare-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":132,"method":"tools/call","params":{"name":"get_traffic_anomalies_by_location","arguments":{"dateRange":"7d","limit":10}}}
