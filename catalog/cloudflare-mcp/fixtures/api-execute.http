# description: List Worker scripts through code mode
POST /mcp HTTP/1.1
Host: mcp.cloudflare.com
Authorization: Bearer opf_cloudflare-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"execute","arguments":{"code":"async () => { const r = await cloudflare.request({ method: 'GET', path: `/accounts/${accountId}/workers/scripts` }); return r.result.map(s => s.id) }","account_id":"023e105f4ecef8ad9ca31a8372d0c353"}}}
