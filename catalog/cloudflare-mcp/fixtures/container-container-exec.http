# description: Run a shell command in the sandbox container: python3 -c 'print(sum(range(10)))'
POST /mcp HTTP/1.1
Host: containers.mcp.cloudflare.com
Authorization: Bearer opf_cloudflare-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

