# description: Find D1 endpoints in the Cloudflare API spec
POST /mcp HTTP/1.1
Host: mcp.cloudflare.com
Authorization: Bearer opf_cloudflare-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"search","arguments":{"code":"async () => Object.keys(spec.paths).filter(p => p.includes('/d1/'))"}}}
