# description: Take a screenshot of https://shop-example.com/pricing
POST /mcp HTTP/1.1
Host: browser.mcp.cloudflare.com
Authorization: Bearer opf_cloudflare-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":59,"method":"tools/call","params":{"name":"get_url_screenshot","arguments":{"url":"https://shop-example.com/pricing","viewport":{"width":1280,"height":800}}}}
