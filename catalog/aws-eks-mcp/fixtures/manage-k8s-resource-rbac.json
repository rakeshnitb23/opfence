{
  "description": "Bind cluster-admin to service account agent in namespace shop",
  "tool": "manage_k8s_resource",
  "arguments": {
    "cluster_name": "shop-prod",
    "operation": "create",
    "kind": "ClusterRoleBinding",
    "api_version": "rbac.authorization.k8s.io/v1",
    "name": "agent-admin",
    "body": {
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "ClusterRole",
        "name": "cluster-admin"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "agent",
          "namespace": "shop"
        }
      ]
    }
  }
}
