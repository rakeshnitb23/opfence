# description: Reset branch br-shop-main-123456 of project shop-prod-12345678 to its parent, discarding its changes
POST /mcp HTTP/1.1
Host: mcp.neon.tech
Authorization: Bearer opf_neon-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"reset_from_parent","arguments":{"project_id":"shop-prod-12345678","branch_id":"br-shop-main-123456","preserve_under_name":"feature-before-reset"}}}
