# description: Run a BigQuery job in project acme-prod: change every row or drop a table
POST /bigquery/v2/projects/acme-prod/jobs HTTP/1.1
Host: bigquery.googleapis.com
Authorization: Bearer opf_EXAMPLE_google_access_token
Content-Type: application/json

{"configuration": {"query": {"query": "DELETE FROM sales.orders WHERE true", "useLegacySql": false}}}
