# description: Change Cloud SQL instance orders-db in project acme-prod (settings.ipConfiguration.authorizedNetworks)
PATCH /v1/projects/acme-prod/instances/orders-db HTTP/1.1
Host: sqladmin.googleapis.com
Authorization: Bearer opf_EXAMPLE_google_access_token
Content-Type: application/json

{"settings": {"ipConfiguration": {"authorizedNetworks": ["10.0.0.0/8"]}}}
