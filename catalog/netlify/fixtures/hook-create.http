# description: Send deploy_failed events of Netlify site 3f1c2a9e-7b4d-4c1a-9e2f-6a8b0c1d2e3f to a url hook
POST /api/v1/hooks?site_id=3f1c2a9e-7b4d-4c1a-9e2f-6a8b0c1d2e3f HTTP/1.1
Host: api.netlify.com
Authorization: Bearer opf_netlify_EXAMPLE
Content-Type: application/json

{"type":"url","event":"deploy_failed","data":{"url":"https://hooks.example.com/netlify"}}
