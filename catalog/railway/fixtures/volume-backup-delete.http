# description: Delete Railway volume backup bak-nightly
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation VolumeInstanceBackupDelete($volumeInstanceBackupId: String!, $volumeInstanceId: String!) { volumeInstanceBackupDelete(volumeInstanceBackupId: $volumeInstanceBackupId, volumeInstanceId: $volumeInstanceId) { __typename } }","variables":{"volumeInstanceBackupId":"bak-nightly","volumeInstanceId":"vi-pg-data"}}
