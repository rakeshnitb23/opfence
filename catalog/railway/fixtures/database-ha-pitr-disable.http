# description: Turn off point-in-time recovery for HA cluster svc-pg
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation DisablePitrForHaCluster($input: DisablePitrForHaClusterInput!) { disablePitrForHaCluster(input: $input) { __typename } }","variables":{"input":{"projectId":"prj-shop","environmentId":"env-production","rootServiceId":"svc-pg"}}}
