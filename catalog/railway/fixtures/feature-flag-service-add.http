# description: Turn on feature flag USE_VM_RUNTIME for service svc-api
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation ServiceFeatureFlagAdd($input: ServiceFeatureFlagToggleInput!) { serviceFeatureFlagAdd(input: $input) }","variables":{"input":{"serviceId":"svc-api","flag":"USE_VM_RUNTIME"}}}
