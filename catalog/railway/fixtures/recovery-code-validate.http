# description: Use a two-factor recovery code
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation RecoveryCodeValidate($input: RecoveryCodeValidateInput!) { recoveryCodeValidate(input: $input) }","variables":{"input":{"code":"recovery-code-1"}}}
