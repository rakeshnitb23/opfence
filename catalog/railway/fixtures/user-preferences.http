# description: Update the Railway email preferences
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation PreferencesUpdate($input: PreferencesUpdateData!) { preferencesUpdate(input: $input) { __typename } }","variables":{"input":{"marketingEmail":false}}}
