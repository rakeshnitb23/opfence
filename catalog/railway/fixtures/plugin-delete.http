# description: Delete Railway database plugin plg-postgres
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation PluginDelete($id: String!, $environmentId: String) { pluginDelete(id: $id, environmentId: $environmentId) }","variables":{"id":"plg-postgres","environmentId":"env-production"}}
