# description: Remove flags ["BETA"] from the user
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation UserFlagsRemove($input: UserFlagsRemoveInput!) { userFlagsRemove(input: $input) }","variables":{"input":{"flags":["BETA"]}}}
