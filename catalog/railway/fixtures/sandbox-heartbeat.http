# description: Extend the lifetime of sandbox sbx-1
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation SandboxHeartbeat($environmentId: String!, $id: String!) { sandboxHeartbeat(environmentId: $environmentId, id: $id) { id } }","variables":{"environmentId":"env-production","id":"sbx-1"}}
