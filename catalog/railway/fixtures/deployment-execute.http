# description: Run the deployed command of service instance si-cron now
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation DeploymentInstanceExecutionCreate($input: DeploymentInstanceExecutionCreateInput!) { deploymentInstanceExecutionCreate(input: $input) }","variables":{"input":{"serviceInstanceId":"si-cron"}}}
