# description: Give service svc-api a public railway.app domain
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation ServiceDomainCreate($input: ServiceDomainCreateInput!) { serviceDomainCreate(input: $input) { __typename } }","variables":{"input":{"serviceId":"svc-api","environmentId":"env-production"}}}
