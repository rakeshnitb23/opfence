# description: Deploy the connected triggers of service svc-api in environment env-production
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation EnvironmentTriggersDeploy($input: EnvironmentTriggersDeployInput!) { environmentTriggersDeploy(input: $input) }","variables":{"input":{"projectId":"prj-shop","environmentId":"env-production","serviceId":"svc-api"}}}
