# description: Create cloud agent dev in environment env-production
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation CloudAgentCreate($input: CloudAgentCreateInput!) { cloudAgentCreate(input: $input) { __typename } }","variables":{"input":{"environmentId":"env-production","name":"dev"}}}
