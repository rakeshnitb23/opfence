# description: Create bucket assets in project prj-shop
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation BucketCreate($input: BucketCreateInput!) { bucketCreate(input: $input) { __typename } }","variables":{"input":{"projectId":"prj-shop","environmentId":"env-production","name":"assets"}}}
