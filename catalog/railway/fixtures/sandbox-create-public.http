# description: Create a sandbox in environment env-production
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation SandboxCreate($input: SandboxCreateInput!) { sandboxCreate(input: $input) { id } }","variables":{"input":{"environmentId":"env-production","publicDomains":[{"port":3000}]}}}
