# description: Change name, avatar or region of workspace ws-acme
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation WorkspaceUpdate($id: String!, $input: WorkspaceUpdateInput!) { workspaceUpdate(id: $id, input: $input) }","variables":{"id":"ws-acme","input":{"name":"Acme"}}}
