# description: Add DNS record CNAME www.example.com -> shop.up.railway.app
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation RailwayDomainDnsRecordCreate($input: RailwayDomainDnsRecordCreateInput!) { railwayDomainDnsRecordCreate(input: $input) { __typename } }","variables":{"input":{"workspaceId":"ws-acme","domain":"example.com","host":"www","type":"CNAME","answer":"shop.up.railway.app"}}}
