# description: Delete every private network of environment env-production
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation PrivateNetworksForEnvironmentDelete($environmentId: String!) { privateNetworksForEnvironmentDelete(environmentId: $environmentId) }","variables":{"environmentId":"env-production"}}
