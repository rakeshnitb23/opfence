# description: Validate a two-factor code
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation TwoFactorInfoValidate($input: TwoFactorInfoValidateInput!) { twoFactorInfoValidate(input: $input) }","variables":{"input":{"token":"123456"}}}
