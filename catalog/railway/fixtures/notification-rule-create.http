# description: Create a notification rule for ["DEPLOY_FAILED"] in workspace ws-acme
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation NotificationRuleCreate($input: CreateNotificationRuleInput!) { notificationRuleCreate(input: $input) { id } }","variables":{"input":{"workspaceId":"ws-acme","eventTypes":["DEPLOY_FAILED"],"channelConfigs":[{"type":"email"}]}}}
