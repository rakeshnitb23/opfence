# description: Create signal new-checkout for prj-shop
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation SignalCreate($input: SignalCreateInput!) { signalCreate(input: $input) { __typename } }","variables":{"input":{"owner":"prj-shop","name":"new-checkout","type":"BOOLEAN","default":false}}}
