# description: Issue a new certificate for custom domain cd-1
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation CustomDomainIssueCertificate($id: String!) { customDomainIssueCertificate(id: $id) }","variables":{"id":"cd-1"}}
