# description: Create a Railway volume at /data for service svc-api
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation VolumeCreate($input: VolumeCreateInput!) { volumeCreate(input: $input) { __typename } }","variables":{"input":{"projectId":"prj-shop","environmentId":"env-production","serviceId":"svc-api","mountPath":"/data"}}}
