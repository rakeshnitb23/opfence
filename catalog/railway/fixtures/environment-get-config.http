# description: Read environment env-production
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"query Environment($id: String!, $decryptVariables: Boolean) { environment(id: $id) { id config(decryptVariables: $decryptVariables) } }","variables":{"id":"env-production","decryptVariables":true}}
