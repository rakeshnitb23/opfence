# description: Turn on feature flag PLACEHOLDER for project prj-shop
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation ProjectFeatureFlagAdd($input: ProjectFeatureFlagToggleInput!) { projectFeatureFlagAdd(input: $input) }","variables":{"input":{"projectId":"prj-shop","flag":"PLACEHOLDER"}}}
