# description: Turn off feature flag CLOUD_AGENTS for the user
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation FeatureFlagRemove($input: FeatureFlagToggleInput!) { featureFlagRemove(input: $input) }","variables":{"input":{"flag":"CLOUD_AGENTS"}}}
