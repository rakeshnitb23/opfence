# description: Create a shell token for service svc-api
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation GenerateShellToken($input: ShellTokenInput!) { generateShellToken(input: $input) }","variables":{"input":{"serviceId":"svc-api","environmentId":"env-production"}}}
