# description: Put customer cus-1 on the free plan
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation CustomerCreateFreePlanSubscription($id: String!) { customerCreateFreePlanSubscription(id: $id) }","variables":{"id":"cus-1"}}
