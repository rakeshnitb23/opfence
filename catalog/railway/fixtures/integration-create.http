# description: Create integration vercel for project prj-shop
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation IntegrationCreate($input: IntegrationCreateInput!) { integrationCreate(input: $input) { id } }","variables":{"input":{"projectId":"prj-shop","name":"vercel","config":{"vercelProjectId":"prj_web"},"integrationAuthId":"ia-1"}}}
