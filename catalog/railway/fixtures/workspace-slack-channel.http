# description: Create a Slack support channel for workspace ws-acme
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation UpsertSlackChannel($workspaceId: String!) { upsertSlackChannel(workspaceId: $workspaceId) }","variables":{"workspaceId":"ws-acme"}}
