# description: Import the variables of Heroku app heroku-shop into service svc-api
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation HerokuImportVariables($input: HerokuImportVariablesInput!) { herokuImportVariables(input: $input) }","variables":{"input":{"projectId":"prj-shop","environmentId":"env-production","serviceId":"svc-api","herokuAppId":"heroku-shop"}}}
