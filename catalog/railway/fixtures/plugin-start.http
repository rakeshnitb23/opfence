# description: Start legacy plugin plg-postgres
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation PluginStart($id: String!, $input: PluginRestartInput!) { pluginStart(id: $id, input: $input) }","variables":{"id":"plg-postgres","input":{"environmentId":"env-production"}}}
