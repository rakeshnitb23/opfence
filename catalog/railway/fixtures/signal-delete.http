# description: Delete signal new-checkout and its audit log
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation SignalDelete($input: SignalDeleteInput!) { signalDelete(input: $input) { __typename } }","variables":{"input":{"owner":"prj-shop","name":"new-checkout"}}}
