{"query":"mutation CustomDomainCreate($input: CustomDomainCreateInput!) { customDomainCreate(input: $input) { __typename } }","variables":{"input":{"projectId":"prj-shop","environmentId":"env-production","serviceId":"svc-api","domain":"api.example.com"}}}
