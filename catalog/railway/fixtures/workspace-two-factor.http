# description: Set two-factor enforcement for workspace ws-acme to false
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation WorkspaceTwoFactorEnforcementUpdate($workspaceId: String!, $enabled: Boolean!) { workspaceTwoFactorEnforcementUpdate(workspaceId: $workspaceId, enabled: $enabled) }","variables":{"workspaceId":"ws-acme","enabled":false}}
