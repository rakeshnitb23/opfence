# description: Reset the credentials of legacy plugin plg-postgres
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation PluginResetCredentials($id: String!, $input: ResetPluginCredentialsInput!) { pluginResetCredentials(id: $id, input: $input) }","variables":{"id":"plg-postgres","input":{"environmentId":"env-production"}}}
