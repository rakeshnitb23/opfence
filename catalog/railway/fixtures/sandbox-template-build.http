# description: Build sandbox template node in environment env-production
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation SandboxTemplateBuild($environmentId: String!, $input: SandboxTemplateInput!) { sandboxTemplateBuild(environmentId: $environmentId, input: $input) { __typename } }","variables":{"environmentId":"env-production","input":{"name":"node","instructions":["npm i -g pnpm"]}}}
