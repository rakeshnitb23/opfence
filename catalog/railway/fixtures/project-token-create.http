# description: Create project token deploy for project prj-shop
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation ProjectTokenCreate($input: ProjectTokenCreateInput!) { projectTokenCreate(input: $input) }","variables":{"input":{"projectId":"prj-shop","environmentId":"env-production","name":"deploy"}}}
