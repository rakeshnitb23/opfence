# description: Read the S3 credentials of bucket bkt-assets
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"query BucketS3Credentials($projectId: String!, $environmentId: String!, $bucketId: String!) { bucketS3Credentials(projectId: $projectId, environmentId: $environmentId, bucketId: $bucketId) { __typename } }","variables":{"projectId":"prj-shop","environmentId":"env-production","bucketId":"bkt-assets"}}
