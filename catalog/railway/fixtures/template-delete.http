# description: Delete template tpl-shop
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation TemplateDelete($id: String!, $input: TemplateDeleteInput!) { templateDelete(id: $id, input: $input) }","variables":{"id":"tpl-shop","input":{"workspaceId":"ws-acme"}}}
