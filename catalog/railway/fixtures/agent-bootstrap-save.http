# description: Save cloud agent ca-dev's disk as bootstrap base
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation AgentBootstrapSave($input: AgentBootstrapSaveInput!) { agentBootstrapSave(input: $input) { __typename } }","variables":{"input":{"cloudAgentId":"ca-dev","name":"base"}}}
