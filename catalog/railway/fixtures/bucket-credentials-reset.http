# description: Reset and read the S3 credentials of bucket bkt-assets
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation BucketCredentialsReset($projectId: String!, $environmentId: String!, $bucketId: String!) { bucketCredentialsReset(projectId: $projectId, environmentId: $environmentId, bucketId: $bucketId) { accessKeyId } }","variables":{"projectId":"prj-shop","environmentId":"env-production","bucketId":"bkt-assets"}}
