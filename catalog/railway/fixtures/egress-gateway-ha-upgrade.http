# description: Switch service svc-api to HA static egress IPs
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation EgressGatewayUpgradeToHA($input: EgressGatewayServiceTargetInput!) { egressGatewayUpgradeToHA(input: $input) { __typename } }","variables":{"input":{"environmentId":"env-production","serviceId":"svc-api","allEnvironments":true}}}
