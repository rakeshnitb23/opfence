# description: Deploy skipped service svc-api in environment env-production
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation EnvironmentUnskipService($environmentId: String!, $serviceId: String!) { environmentUnskipService(environmentId: $environmentId, serviceId: $serviceId) }","variables":{"environmentId":"env-production","serviceId":"svc-api"}}
