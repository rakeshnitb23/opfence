# description: Publish template tpl-shop to the marketplace
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation TemplatePublish($id: String!, $input: TemplatePublishInput!) { templatePublish(id: $id, input: $input) { id } }","variables":{"id":"tpl-shop","input":{"category":"Starters","description":"Shop","readme":"# Shop","workspaceId":"ws-acme"}}}
