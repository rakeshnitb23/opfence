# description: Duplicate service svc-api with its variables and volumes
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation ServiceDuplicate($environmentId: String!, $serviceId: String!) { serviceDuplicate(environmentId: $environmentId, serviceId: $serviceId) { id } }","variables":{"environmentId":"env-production","serviceId":"svc-api"}}
