# description: Delete Railway project prj-shop now, skipping the grace period
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation ProjectScheduleDeleteForce($id: String!) { projectScheduleDeleteForce(id: $id) }","variables":{"id":"prj-shop"}}
