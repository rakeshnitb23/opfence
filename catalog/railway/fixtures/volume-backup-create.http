# description: Back up Railway volume instance vi-pg-data
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation VolumeInstanceBackupCreate($volumeInstanceId: String!, $name: String) { volumeInstanceBackupCreate(volumeInstanceId: $volumeInstanceId, name: $name) { __typename } }","variables":{"volumeInstanceId":"vi-pg-data","name":"before-migration"}}
