# description: Disconnect Railway service svc-api from its source repository
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation ServiceDisconnect($id: String!) { serviceDisconnect(id: $id) { __typename } }","variables":{"id":"svc-api"}}
