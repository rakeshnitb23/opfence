# description: Set the referral code of workspace ws-acme to acme
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation ReferralInfoUpdate($input: ReferralInfoUpdateInput!) { referralInfoUpdate(input: $input) { __typename } }","variables":{"input":{"workspaceId":"ws-acme","code":"acme"}}}
