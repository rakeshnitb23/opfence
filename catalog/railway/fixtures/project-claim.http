# description: Claim project prj-shop into workspace ws-acme
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation ProjectClaim($id: String!, $workspaceId: String!) { projectClaim(id: $id, workspaceId: $workspaceId) { id } }","variables":{"id":"prj-shop","workspaceId":"ws-acme"}}
