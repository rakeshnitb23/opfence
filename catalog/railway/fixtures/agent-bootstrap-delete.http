# description: Delete cloud agent bootstrap abs-base and every version's disk snapshot
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation AgentBootstrapDelete($id: ID!) { agentBootstrapDelete(id: $id) }","variables":{"id":"abs-base"}}
