# description: Give service svc-api a static egress IP
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation EgressGatewayAssociationCreate($input: EgressGatewayCreateInput!) { egressGatewayAssociationCreate(input: $input) { __typename } }","variables":{"input":{"environmentId":"env-production","serviceId":"svc-api"}}}
