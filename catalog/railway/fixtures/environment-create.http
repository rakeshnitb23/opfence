# description: Create environment pr-42 in project prj-shop
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation EnvironmentCreate($input: EnvironmentCreateInput!) { environmentCreate(input: $input) { __typename } }","variables":{"input":{"projectId":"prj-shop","name":"pr-42"}}}
