{"query":"mutation DeploymentTriggerCreate($input: DeploymentTriggerCreateInput!) { deploymentTriggerCreate(input: $input) { __typename } }","variables":{"input":{"projectId":"prj-shop","environmentId":"env-production","serviceId":"svc-api","provider":"github","repository":"acme/shop","branch":"main"}}}
