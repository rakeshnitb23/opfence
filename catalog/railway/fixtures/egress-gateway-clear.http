# description: Release the static egress IPs of service svc-api
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation EgressGatewayAssociationsClear($input: EgressGatewayServiceTargetInput!) { egressGatewayAssociationsClear(input: $input) }","variables":{"input":{"environmentId":"env-production","serviceId":"svc-api"}}}
