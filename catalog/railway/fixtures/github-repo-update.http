# description: Update service svc-api's repo from its template
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation GithubRepoUpdate($input: GitHubRepoUpdateInput!) { githubRepoUpdate(input: $input) }","variables":{"input":{"projectId":"prj-shop","environmentId":"env-production","serviceId":"svc-api"}}}
