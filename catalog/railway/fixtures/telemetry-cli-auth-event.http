# description: Send a Railway CLI sign-in telemetry event
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation CliAuthEventTrack($input: CliAuthEventTrackInput!) { cliAuthEventTrack(input: $input) }","variables":{"input":{"outcome":"success","success":true,"transport":"browser"}}}
