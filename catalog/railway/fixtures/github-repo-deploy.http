# description: Deploy GitHub repo acme/shop into project prj-shop
POST /graphql/v2 HTTP/1.1
Host: backboard.railway.com
Authorization: Bearer opf_railway_EXAMPLE
Content-Type: application/json

{"query":"mutation GithubRepoDeploy($input: GitHubRepoDeployInput!) { githubRepoDeploy(input: $input) }","variables":{"input":{"projectId":"prj-shop","environmentId":"env-production","repo":"acme/shop","branch":"main"}}}
