# description: Create logging destination external-logs
POST /v2/monitoring/sinks/destinations HTTP/1.1
Host: api.digitalocean.com
Authorization: Bearer opf_digitalocean_EXAMPLE
Content-Type: application/json

{"name": "external-logs", "type": "opensearch_ext", "config": {"endpoint": "https://search.example.com:9200", "index_name": "logs", "credentials": {"username": "shipper", "password": "opf_digitalocean_EXAMPLE"}}}
