Content-Type: application/json

{"spec": {"name": "shop-web", "region": "nyc", "domains": [{"domain": "shop.example.com", "type": "PRIMARY"}], "services": [{"name": "web", "github": {"repo": "acme/shop-web", "branch": "main"}}]}}
