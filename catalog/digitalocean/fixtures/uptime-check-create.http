# description: Create uptime check Landing page check for https://www.landingpage.com
POST /v2/uptime/checks HTTP/1.1
Host: api.digitalocean.com
Authorization: Bearer opf_digitalocean_EXAMPLE
Content-Type: application/json

{"name": "Landing page check", "type": "https", "target": "https://www.landingpage.com", "regions": ["us_east", "eu_west"], "enabled": true}
