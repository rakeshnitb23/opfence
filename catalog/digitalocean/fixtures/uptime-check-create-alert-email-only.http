# description: Add alert Landing page degraded to uptime check 4de7ac8b-495b-4884-9a69-1050c6793cd6
POST /v2/uptime/checks/4de7ac8b-495b-4884-9a69-1050c6793cd6/alerts HTTP/1.1
Host: api.digitalocean.com
Authorization: Bearer opf_digitalocean_EXAMPLE
Content-Type: application/json

{"name": "Landing page degraded", "type": "latency", "threshold": 300, "comparison": "greater_than", "notifications": {"email": ["ops@example.com"], "slack": []}, "period": "2m"}
