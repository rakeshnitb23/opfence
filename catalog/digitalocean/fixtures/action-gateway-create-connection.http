# description: Connect user alice to tool provider jira
POST /v2/action-gateway/connections HTTP/1.1
Host: api.digitalocean.com
Authorization: Bearer opf_digitalocean_EXAMPLE
Content-Type: application/json

{"provider": "jira", "user_id": "alice", "scopes": ["write:jira-work"], "connection_parameters": {"site_url": "https://example.atlassian.net"}, "credential": {"digitalocean_oauth": {}}}
