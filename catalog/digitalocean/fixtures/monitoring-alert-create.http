{"alerts": {"email": ["bob@exmaple.com"], "slack": [{"channel": "Production Alerts", "url": "https://hooks.slack.com/services/EXAMPLE"}]}, "compare": "GreaterThan", "description": "CPU Alert", "enabled": true, "entities": ["192018292"], "tags": ["droplet_tag"], "type": "v1/insights/droplet/cpu", "value": 80, "window": "5m"}
