# description: Forward logs of cluster 9cc10173-e9ea-4176-9dbc-a4cee4c4ff30 to rsyslog sink logs-sink
POST /v2/databases/9cc10173-e9ea-4176-9dbc-a4cee4c4ff30/logsink HTTP/1.1
Host: api.digitalocean.com
Authorization: Bearer opf_digitalocean_EXAMPLE
Content-Type: application/json

{"sink_name": "logs-sink", "sink_type": "rsyslog", "config": {"server": "logs.example.com", "port": 514, "tls": true, "format": "rfc5424"}}
