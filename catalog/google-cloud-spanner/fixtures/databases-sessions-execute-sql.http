# description: Run SQL on Spanner database orders of instance orders-db in project acme-prod
POST /v1/projects/acme-prod/instances/orders-db/databases/orders/sessions/session-1:executeSql HTTP/1.1
Host: spanner.googleapis.com
Authorization: Bearer opf_EXAMPLE_google_access_token
Content-Type: application/json

{"sql": "SELECT SingerId FROM Singers WHERE SingerId = @id"}
