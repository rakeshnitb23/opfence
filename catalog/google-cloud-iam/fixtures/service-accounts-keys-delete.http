# description: Delete key key-1 of service account deployer@acme-prod.iam.gserviceaccount.com in project acme-prod
DELETE /v1/projects/acme-prod/serviceAccounts/deployer@acme-prod.iam.gserviceaccount.com/keys/key-1 HTTP/1.1
Host: iam.googleapis.com
Authorization: Bearer opf_EXAMPLE_google_access_token

