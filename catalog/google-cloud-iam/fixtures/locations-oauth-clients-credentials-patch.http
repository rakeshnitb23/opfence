# description: Change credential credential-1 of OAuth client oauthclient-1 in project acme-prod
PATCH /v1/projects/acme-prod/locations/us-central1/oauthClients/oauthclient-1/credentials/credential-1 HTTP/1.1
Host: iam.googleapis.com
Authorization: Bearer opf_EXAMPLE_google_access_token
Content-Type: application/json

{}
