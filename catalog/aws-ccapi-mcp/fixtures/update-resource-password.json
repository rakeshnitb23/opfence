{
  "description": "Change the master password of RDS instance shop-db",
  "tool": "update_resource",
  "arguments": {
    "resource_type": "AWS::RDS::DBInstance",
    "identifier": "shop-db",
    "patch_document": [
      {
        "op": "replace",
        "path": "/MasterUserPassword",
        "value": "opf_aws_EXAMPLE"
      }
    ],
    "region": "us-east-1",
    "credentials_token": "credentials-token-EXAMPLE",
    "explained_token": "explained-token-EXAMPLE"
  }
}
