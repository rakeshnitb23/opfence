# description: Add OAuth provider google to Neon Auth in project shop-prod-12345678
POST /api/v2/projects/shop-prod-12345678/auth/oauth_providers HTTP/1.1
Host: console.neon.tech
Authorization: Bearer opf_neon_EXAMPLE
Content-Type: application/json

{"id":"google","client_id":"shop.apps.example","client_secret":"opf_oauth_EXAMPLE"}
