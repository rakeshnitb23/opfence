# description: Search open pull requests by octo-dev in acme/shop
POST /mcp/ HTTP/1.1
Host: api.githubcopilot.com
Authorization: Bearer opf_github-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"search_pull_requests","arguments":{"query":"repo:acme/shop is:open author:octo-dev"}}}
