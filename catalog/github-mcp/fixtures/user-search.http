# description: Search users in Berlin who write Go
POST /mcp/ HTTP/1.1
Host: api.githubcopilot.com
Authorization: Bearer opf_github-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"search_users","arguments":{"query":"location:berlin language:go"}}}
