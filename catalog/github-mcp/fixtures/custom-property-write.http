# description: Set the environment property of acme/shop
POST /mcp/ HTTP/1.1
Host: api.githubcopilot.com
Authorization: Bearer opf_github-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"custom_properties_write","arguments":{"owner":"acme","repo":"shop","level":"repository","properties":[{"property_name":"environment","value":"staging"}]}}}
