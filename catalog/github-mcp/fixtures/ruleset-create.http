{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"create_repository_ruleset","arguments":{"owner":"acme","repo":"shop","level":"repository","name":"protect-main","enforcement":"active","target":"branch","conditions":{"ref_name":{"include":["~DEFAULT_BRANCH"],"exclude":[]}},"rules":[{"type":"pull_request"},{"type":"non_fast_forward"}]}}}
