# description: Delete domain example.com and all its DNS records
POST /mcp HTTP/1.1
Host: networking.mcp.digitalocean.com
Authorization: Bearer opf_digitalocean-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":305,"method":"tools/call","params":{"name":"domain-delete","arguments":{"Name":"example.com"}}}
