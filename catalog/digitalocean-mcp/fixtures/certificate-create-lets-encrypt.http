# description: Request a Let's Encrypt certificate shop-www
POST /mcp HTTP/1.1
Host: networking.mcp.digitalocean.com
Authorization: Bearer opf_digitalocean-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":300,"method":"tools/call","params":{"name":"lets-encrypt-certificate-create","arguments":{"Name":"shop-www","DnsNames":["www.example.com"]}}}
