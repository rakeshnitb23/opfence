# description: Import custom image ubuntu-custom from https://images.example.com/ubuntu-custom.qcow2
POST /mcp HTTP/1.1
Host: droplets.mcp.digitalocean.com
Authorization: Bearer opf_digitalocean-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":141,"method":"tools/call","params":{"name":"image-create","arguments":{"Name":"ubuntu-custom","Url":"https://images.example.com/ubuntu-custom.qcow2","Region":"nyc3"}}}
