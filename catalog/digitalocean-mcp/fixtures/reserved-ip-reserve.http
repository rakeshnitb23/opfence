# description: Reserve a new ipv4 address in nyc3
POST /mcp HTTP/1.1
Host: networking.mcp.digitalocean.com
Authorization: Bearer opf_digitalocean-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":333,"method":"tools/call","params":{"name":"reserved-ip-reserve","arguments":{"Region":"nyc3","Type":"ipv4"}}}
