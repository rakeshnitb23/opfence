# description: Power off every Droplet tagged web
POST /mcp HTTP/1.1
Host: droplets.mcp.digitalocean.com
Authorization: Bearer opf_digitalocean-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":118,"method":"tools/call","params":{"name":"power-off-droplets-tag","arguments":{"Tag":"web"}}}
