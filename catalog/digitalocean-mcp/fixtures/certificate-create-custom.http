# description: Upload certificate shop-wildcard with its private key
POST /mcp HTTP/1.1
Host: networking.mcp.digitalocean.com
Authorization: Bearer opf_digitalocean-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":299,"method":"tools/call","params":{"name":"custom-certificate-create","arguments":{"Name":"shop-wildcard","PrivateKey":"opf_digitalocean-mcp_EXAMPLE","LeafCertificate":"EXAMPLE-LEAF-CERTIFICATE","CertificateChain":"EXAMPLE-CERTIFICATE-CHAIN"}}}
