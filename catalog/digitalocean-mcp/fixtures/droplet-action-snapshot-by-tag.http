# description: Snapshot every Droplet tagged web as web-nightly
POST /mcp HTTP/1.1
Host: droplets.mcp.digitalocean.com
Authorization: Bearer opf_digitalocean-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":134,"method":"tools/call","params":{"name":"snapshot-droplets-tag","arguments":{"Tag":"web","Name":"web-nightly"}}}
