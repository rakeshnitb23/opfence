# description: List DNS records of example.com
POST /mcp HTTP/1.1
Host: networking.mcp.digitalocean.com
Authorization: Bearer opf_digitalocean-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":306,"method":"tools/call","params":{"name":"domain-record-list","arguments":{"Domain":"example.com"}}}
