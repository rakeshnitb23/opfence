# description: Create a Notion file upload for diagram.png
POST /mcp HTTP/1.1
Host: mcp.notion.com
Authorization: Bearer opf_notion-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":40,"method":"tools/call","params":{"name":"notion-create-file-upload","arguments":{"filename":"diagram.png"}}}
