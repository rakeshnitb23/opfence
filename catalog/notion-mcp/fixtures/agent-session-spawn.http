# description: Start a Notion Custom Agent session with https://www.notion.so/acme/agents/triage-bot
POST /mcp HTTP/1.1
Host: mcp.notion.com
Authorization: Bearer opf_notion-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":54,"method":"tools/call","params":{"name":"notion-spawn-session","arguments":{"agent":"https://www.notion.so/acme/agents/triage-bot","message":"Archive every page tagged stale"}}}
