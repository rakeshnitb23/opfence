# description: Show which Notion MCP tools the plan allows
POST /mcp HTTP/1.1
Host: mcp.notion.com
Authorization: Bearer opf_notion-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"notion-get-tool-access","arguments":{"tool_names":["notion-search","notion-query-data-sources"]}}}
