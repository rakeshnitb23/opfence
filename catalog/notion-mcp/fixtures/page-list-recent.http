# description: List recently viewed Notion pages
POST /mcp HTTP/1.1
Host: mcp.notion.com
Authorization: Bearer opf_notion-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":14,"method":"tools/call","params":{"name":"notion-list-recent-pages","arguments":{"limit":25}}}
