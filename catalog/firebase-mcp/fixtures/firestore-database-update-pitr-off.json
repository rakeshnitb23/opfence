{
  "description": "Turn off point-in-time recovery",
  "tool": "firestore_update_database",
  "arguments": {
    "database": {
      "name": "projects/shop-prod/databases/(default)",
      "pointInTimeRecoveryEnablement": "POINT_IN_TIME_RECOVERY_DISABLED"
    },
    "updateMask": "pointInTimeRecoveryEnablement"
  }
}
