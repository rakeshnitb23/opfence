# description: Run Sentry tool delete_alert_rule in organization my-org
POST /mcp HTTP/1.1
Host: mcp.sentry.dev
Authorization: Bearer opf_sentry-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":7,"method":"tools/call","params":{"name":"execute_sentry_tool","arguments":{"name":"delete_alert_rule","arguments":{"organizationSlug":"my-org","ruleId":"12345"}}}}
