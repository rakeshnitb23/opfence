# description: Run Sentry tool update_metric_monitor in organization my-org
POST /mcp HTTP/1.1
Host: mcp.sentry.dev
Authorization: Bearer opf_sentry-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":8,"method":"tools/call","params":{"name":"execute_sentry_tool","arguments":{"name":"update_metric_monitor","arguments":{"organizationSlug":"my-org","monitorId":"12345","status":"disabled"}}}}
