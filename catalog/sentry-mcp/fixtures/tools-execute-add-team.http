{"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"execute_sentry_tool","arguments":{"name":"add_team_to_project","arguments":{"organizationSlug":"my-org","projectSlug":"backend","teamSlug":"platform"}}}}
