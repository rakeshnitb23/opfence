# description: Set environment variables on service srv-shopweb01 and redeploy it
POST /mcp HTTP/1.1
Host: mcp.render.com
Authorization: Bearer opf_render-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

{"jsonrpc":"2.0","id":1,"method":"tools/call","params":{"name":"update_environment_variables","arguments":{"serviceId":"srv-shopweb01","replace":true,"envVars":[{"key":"LOG_LEVEL","value":"debug"}],"workspaceId":"tea-acme01"}}}
