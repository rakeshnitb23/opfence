# description: Create Turso database app-db in group default
POST /v1/organizations/acme/databases HTTP/1.1
Host: api.turso.tech
Authorization: Bearer opf_turso_EXAMPLE
Content-Type: application/json

{"name":"app-db","group":"default","remote_encryption":{"encryption_key":"opf_turso_EXAMPLE","encryption_cipher":"aes256gcm"}}
