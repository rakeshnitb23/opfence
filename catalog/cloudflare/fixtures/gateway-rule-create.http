# description: Create Gateway rule Block malware
POST /client/v4/accounts/023e105f4ecef8ad9ca31a8372d0c353/gateway/rules HTTP/1.1
Host: api.cloudflare.com
Authorization: Bearer opf_cloudflare_EXAMPLE
Content-Type: application/json

{"name":"Block malware","action":"block","filters":["dns"],"traffic":"any(dns.security_category[*] in {80})","enabled":true}