# description: Set bucket lock (retention) rules of R2 bucket shop-assets
PUT /client/v4/accounts/023e105f4ecef8ad9ca31a8372d0c353/r2/buckets/shop-assets/lock HTTP/1.1
Host: api.cloudflare.com
Authorization: Bearer opf_cloudflare_EXAMPLE
Content-Type: application/json

{"rules":[{"id":"keep-invoices","enabled":true,"prefix":"invoices/","condition":{"type":"Age","maxAgeSeconds":31536000}}]}