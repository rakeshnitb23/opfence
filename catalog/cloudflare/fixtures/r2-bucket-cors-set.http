# description: Set the CORS policy of R2 bucket shop-assets
PUT /client/v4/accounts/023e105f4ecef8ad9ca31a8372d0c353/r2/buckets/shop-assets/cors HTTP/1.1
Host: api.cloudflare.com
Authorization: Bearer opf_cloudflare_EXAMPLE
Content-Type: application/json

{"rules":[{"allowed":{"methods":["GET"],"origins":["https://shop-example.com"]},"maxAgeSeconds":3600}]}