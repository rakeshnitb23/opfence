# description: Create a custom page asset (account)
POST /client/v4/accounts/023e105f4ecef8ad9ca31a8372d0c353/custom_pages/assets HTTP/1.1
Host: api.cloudflare.com
Authorization: Bearer opf_cloudflare_EXAMPLE
Content-Type: application/json

{"description":"Custom 500 error page","name":"my_custom_error_page","url":"https://example.com/error.html"}