# description: Change telemetry destination otel-collector
PATCH /client/v4/accounts/023e105f4ecef8ad9ca31a8372d0c353/workers/observability/destinations/otel-collector HTTP/1.1
Host: api.cloudflare.com
Authorization: Bearer opf_cloudflare_EXAMPLE
Content-Type: application/json

{"enabled":true,"configuration":{"type":"logpush","url":"https://otel.shop-example.com/v1/logs","headers":{"authorization":"opf_cloudflare_EXAMPLE"}}}