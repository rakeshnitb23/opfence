# description: Set object lifecycle rules of R2 bucket shop-assets
PUT /client/v4/accounts/023e105f4ecef8ad9ca31a8372d0c353/r2/buckets/shop-assets/lifecycle HTTP/1.1
Host: api.cloudflare.com
X-Auth-Email: ops@shop-example.com
X-Auth-Key: opf_cloudflare_EXAMPLE
Content-Type: application/json

{"rules":[{"id":"expire-tmp","enabled":true,"conditions":{"prefix":"tmp/"},"deleteObjectsTransition":{"condition":{"type":"Age","maxAge":86400}}}]}