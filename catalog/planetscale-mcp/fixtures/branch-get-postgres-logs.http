# description: Show Postgres logs of branch main of database shop-db
POST /mcp/planetscale HTTP/1.1
Host: mcp.pscale.dev
Authorization: Bearer opf_planetscale-mcp_EXAMPLE
Content-Type: application/json
Accept: application/json, text/event-stream

