# description: Allow cross-organization replays
POST /graphql HTTP/1.1
Host: api.fly.io
Authorization: Bearer opf_flyio_EXAMPLE
Content-Type: application/json

{"query":"mutation AddAllowedReplaySourceOrgs($input: AddAllowedReplaySourceOrgsInput!) { addAllowedReplaySourceOrgs(input: $input) { __typename } }","variables":{"input":{"organizationSlug":"acme","allowedOrgSlugs":["partner"]}}}
