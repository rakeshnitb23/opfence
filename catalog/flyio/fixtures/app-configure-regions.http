# description: Configure app regions
POST /graphql HTTP/1.1
Host: api.fly.io
Authorization: Bearer opf_flyio_EXAMPLE
Content-Type: application/json

{"query":"mutation ConfigureRegions($input: ConfigureRegionsInput!) { configureRegions(input: $input) { __typename } }","variables":{"input":{"appId":"shop-api","allowRegions":["ams","fra"]}}}
