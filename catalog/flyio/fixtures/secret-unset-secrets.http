# description: Unset a secret
POST /graphql HTTP/1.1
Host: api.fly.io
Authorization: Bearer opf_flyio_EXAMPLE
Content-Type: application/json

{"query":"mutation UnsetSecrets($input: UnsetSecretsInput!) { unsetSecrets(input: $input) { __typename } }","variables":{"input":{"appId":"shop-api","keys":["OLD_TOKEN"]}}}
