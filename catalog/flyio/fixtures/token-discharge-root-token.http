# description: Discharge a root token
POST /graphql HTTP/1.1
Host: api.fly.io
Authorization: Bearer opf_flyio_EXAMPLE
Content-Type: application/json

{"query":"mutation DischargeRootToken($input: DischargeRootTokenInput!) { dischargeRootToken(input: $input) { __typename } }","variables":{"input":{"organizationId":42,"rootToken":"opf_flyio_EXAMPLE"}}}
