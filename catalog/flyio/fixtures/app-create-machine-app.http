# description: Create a Machines app
POST /graphql HTTP/1.1
Host: api.fly.io
Authorization: Bearer opf_flyio_EXAMPLE
Content-Type: application/json

{"query":"mutation CreateMachineApp($input: CreateMachineAppInput!) { createMachineApp(input: $input) { __typename } }","variables":{"input":{"appName":"shop-api","organizationSlug":"acme"}}}
