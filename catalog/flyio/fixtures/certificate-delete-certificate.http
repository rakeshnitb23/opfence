# description: Delete a certificate
POST /graphql HTTP/1.1
Host: api.fly.io
Authorization: Bearer opf_flyio_EXAMPLE
Content-Type: application/json

{"query":"mutation DeleteCertificate($appId: ID!, $hostname: String!) { deleteCertificate(appId: $appId, hostname: $hostname) { __typename } }","variables":{"appId":"shop-api","hostname":"shop.example.com"}}
