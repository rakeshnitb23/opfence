# description: Record a build
POST /graphql HTTP/1.1
Host: api.fly.io
Authorization: Bearer opf_flyio_EXAMPLE
Content-Type: application/json

{"query":"mutation CreateBuild($input: CreateBuildInput!) { createBuild(input: $input) { __typename } }","variables":{"input":{"appName":"shop-api","builderType":"remote","strategiesAvailable":["dockerfile"]}}}
