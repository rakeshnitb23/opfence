# description: Add a payment method
POST /graphql HTTP/1.1
Host: api.fly.io
Authorization: Bearer opf_flyio_EXAMPLE
Content-Type: application/json

{"query":"mutation AddStripePaymentMethod($input: AddStripePaymentMethodInput!) { addStripePaymentMethod(input: $input) { __typename } }","variables":{"input":{"stripePaymentMethodId":"pm_EXAMPLE"}}}
