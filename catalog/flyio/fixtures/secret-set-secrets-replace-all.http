# description: Replace all secrets of an app
POST /graphql HTTP/1.1
Host: api.fly.io
Authorization: Bearer opf_flyio_EXAMPLE
Content-Type: application/json

{"query":"mutation SetSecrets($input: SetSecretsInput!) { setSecrets(input: $input) { __typename } }","variables":{"input":{"appId":"shop-api","replaceAll":true,"secrets":[{"key":"STRIPE_API_KEY","value":"opf_flyio_EXAMPLE_VALUE"}]}}}
