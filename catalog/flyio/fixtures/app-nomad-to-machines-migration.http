# description: Migrate an app to Machines
POST /graphql HTTP/1.1
Host: api.fly.io
Authorization: Bearer opf_flyio_EXAMPLE
Content-Type: application/json

{"query":"mutation NomadToMachinesMigration($input: NomadToMachinesMigrationInput!) { nomadToMachinesMigration(input: $input) { __typename } }","variables":{"input":{"appId":"shop-api"}}}
