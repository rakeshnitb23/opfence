# description: Allocate a public IPv6 address
POST /graphql HTTP/1.1
Host: api.fly.io
Authorization: Bearer opf_flyio_EXAMPLE
Content-Type: application/json

{"query":"mutation AllocateIpAddress($input: AllocateIPAddressInput!) { allocateIpAddress(input: $input) { __typename } }","variables":{"input":{"appId":"shop-api","type":"v6"}}}
