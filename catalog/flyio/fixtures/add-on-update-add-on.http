# description: Change add-on options
POST /graphql HTTP/1.1
Host: api.fly.io
Authorization: Bearer opf_flyio_EXAMPLE
Content-Type: application/json

{"query":"mutation UpdateAddOn($input: UpdateAddOnInput!) { updateAddOn(input: $input) { __typename } }","variables":{"input":{"name":"shop-cache","options":{"eviction":true}}}}
