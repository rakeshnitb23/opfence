# description: Allow all cross-network replays
POST /graphql HTTP/1.1
Host: api.fly.io
Authorization: Bearer opf_flyio_EXAMPLE
Content-Type: application/json

{"query":"mutation SetAllowAllCrossNetworkReplays($input: SetAllowAllCrossNetworkReplaysInput!) { setAllowAllCrossNetworkReplays(input: $input) { __typename } }","variables":{"input":{"organizationSlug":"acme","allow":true}}}
