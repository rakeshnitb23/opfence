# description: Add a third-party configuration
POST /graphql HTTP/1.1
Host: api.fly.io
Authorization: Bearer opf_flyio_EXAMPLE
Content-Type: application/json

{"query":"mutation CreateThirdPartyConfiguration($input: CreateThirdPartyConfigurationInput!) { createThirdPartyConfiguration(input: $input) { __typename } }","variables":{"input":{"organizationId":"NOx4Zp9QkV2","name":"sentry","location":"https://example.com","customLevel":"DISABLED","flyctlLevel":"OPT_IN","uiexLevel":"OPT_IN"}}}
