# description: Set the VM count of an app
POST /graphql HTTP/1.1
Host: api.fly.io
Authorization: Bearer opf_flyio_EXAMPLE
Content-Type: application/json

{"query":"mutation SetVmCount($input: SetVMCountInput!) { setVmCount(input: $input) { __typename } }","variables":{"input":{"appId":"shop-api","groupCounts":[{"group":"app","count":4}]}}}
