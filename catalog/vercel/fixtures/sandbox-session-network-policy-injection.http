# description: Replace the network policy of sandbox session sbx_1
POST /v2/sandboxes/sessions/sbx_1/network-policy HTTP/1.1
Host: api.vercel.com
Authorization: Bearer opf_vercel_EXAMPLE
Content-Type: application/json

{"mode":"custom","allowedDomains":["api.example.com"],"injectionRules":[{"domain":"api.example.com","headers":{"Authorization":"Bearer opf_vercel_EXAMPLE"}}]}
